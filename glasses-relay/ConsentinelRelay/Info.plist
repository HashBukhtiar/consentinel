<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Consentinel Relay</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ConsentinelRelay</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Meta AI re-opens this app through this scheme after linking the glasses.
	     It must match MWDAT > AppLinkURLScheme below. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>consentinelrelay</string>
			</array>
		</dict>
	</array>

	<!-- Begin required section for Device Access Toolkit apps -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>consentinelrelay://</string>
		<!-- META_APP_ID and CLIENT_TOKEN come from the Wearables Developer Center.
		     Developer Mode skips attestation, so they can stay empty for the demo;
		     define them as build settings if you register a real app. -->
		<key>MetaAppID</key>
		<string>$(META_APP_ID)</string>
		<key>ClientToken</key>
		<string>$(CLIENT_TOKEN)</string>
		<!-- Filled from Signing & Capabilities > Team. -->
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Needed to connect to your Meta glasses.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Needed to connect to your Meta glasses.</string>
	<!-- Covers both the glasses' Wi-Fi link and this app's own frame server. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Needed to reach your glasses and to send frames to the Consentinel capture app on your laptop.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<!-- End required section for Device Access Toolkit apps -->

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
