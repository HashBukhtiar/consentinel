{
  "name": "consentinel-registry",
  "private": true,
  "version": "0.1.0",
  "description": "Consentinel on-chain consent registry: Anchor program, tests, TS client, demo scripts",
  "scripts": {
    "build": "mkdir -p target/deploy && cp keys/program-keypair.json target/deploy/consent_registry-keypair.json && anchor build --arch v0 && node client/scripts/check-program-id.mjs && npm run sync-idl",
    "test": "anchor test",
    "sync-idl": "node client/scripts/sync-idl.mjs",
    "keys": "tsx client/scripts/keys.mts",
    "seed": "tsx client/scripts/seed.mts",
    "toggle": "tsx client/scripts/toggle.mts",
    "badge-press": "tsx client/scripts/badge-press.mts",
    "watch": "tsx client/scripts/watch.mts",
    "status": "tsx client/scripts/status.mts",
    "register-camera": "tsx scripts/register-camera.mts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "tweetnacl": "^1.0.3",
    "@noble/hashes": "^1.3.0",
    "@anchor-lang/core": "^1.2.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.19.43",
    "chai": "^4.3.4",
    "mocha": "^10.0.0",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
