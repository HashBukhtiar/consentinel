                  111,
                  110,
                  115,
                  101,
                  110,
                  116
                ]
              },
              {
                "kind": "account",
                "path": "consent.badge_id",
                "account": "ConsentAccount"
              }
            ]
          }
        },
        {
          "name": "relayer",
          "docs": [
            "Pays the fee. Any key — authority comes from the badge's signature."
          ],
          "signer": true
