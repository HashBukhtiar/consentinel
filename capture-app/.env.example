# Copy to .env.local. Everything has a working default (devnet + a local service on :8787).

# Consent source: chain (Solana, the real thing) | stub (in-memory toggles, no network)
VITE_CONSENT_SOURCE=chain
# devnet | localnet — the RPC URL follows unless VITE_SOLANA_RPC_URL is set
VITE_SOLANA_CLUSTER=devnet
# A dedicated devnet RPC (Helius/QuickNode) avoids the public endpoint's 429s on stage
VITE_SOLANA_RPC_URL=
# Beacon decoder: optical (real badge / synthetic badge) | stub (two fixed fake beacons, no-badge fallback)
VITE_BEACON_DECODER=optical
# Scope for per-event consent overrides
VITE_EVENT_ID=htn2026-demo

# Notify service (Part C). Empty FILM_EVENT_ENDPOINT ⇒ film-events are only shown locally.
VITE_FILM_EVENT_ENDPOINT=http://localhost:8787/film-event
VITE_SERVICE_WS_URL=ws://localhost:8787/operator
# Must match SERVICE_TOKEN in service/.env when that is set
VITE_SERVICE_TOKEN=

# Sentry (optional): tracing + logs, no session replay. Off when empty.
VITE_SENTRY_DSN=
