# Copy to .env (the service loads it). Everything has a working default except the ElevenLabs key.
PORT=8787

# Solana (devnet). RPC default is the public endpoint; a Helius/QuickNode devnet URL is faster.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Camera authority: signs attest_capture (created by `npm run seed` in registry/)
CAMERA_KEYPAIR=../registry/keys/camera-cam-1.json
CAMERA_ID=cam-1
# Relayer: pays fees for badge-signed consent updates (defaults to ~/.config/solana/id.json)
RELAYER_KEYPAIR=
ATTEST_ON_CHAIN=true

# ElevenLabs — spoken "you were recorded" alert. Without a key the service falls
# back to macOS `say` and labels it as a fallback in /health.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
PLAY_AUDIO_LOCALLY=true

# Audit log (append-only JSONL; no image data ever)
AUDIT_LOG=../data/audit/film-events.jsonl
