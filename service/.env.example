# Copy to .env (the service loads it). Everything has a working default except the ElevenLabs key.
PORT=8787
# Browser origin allowed on the capture-app routes (badges use non-browser clients and are not CORS-gated)
# comma-separated is fine: the origin a request comes from is reflected if it is listed
CORS_ORIGIN=http://localhost:5173,http://consentinel.localhost:5173
# If set, POST /film-event and GET /audit/events require `authorization: Bearer <token>`;
# put the same value in capture-app/.env.local as VITE_SERVICE_TOKEN. Leave empty for an open dev setup.
SERVICE_TOKEN=

# Solana (devnet). RPC default is the public endpoint; a Helius/QuickNode devnet URL is faster
# (its key is redacted from /health).
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Camera authority: signs attest_capture (created + funded by `npm run seed` in registry/)
CAMERA_KEYPAIR=../registry/keys/camera-cam-1.json
CAMERA_ID=cam-1
# Relayer: pays fees for badge-signed consent updates (created + funded by `npm run seed`)
RELAYER_KEYPAIR=../registry/keys/relayer.json
ATTEST_ON_CHAIN=true
# One on-chain commitment per interval (batch of that interval's film-events, or a heartbeat when
# there were none) — a constant cadence so the chain carries no timing signal about captures.
ATTEST_INTERVAL_MS=10000
ATTEST_HEARTBEAT=true

# ElevenLabs — spoken "you were recorded" alert. Without a key the service falls
# back to macOS `say` and labels it as a fallback in /health.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
PLAY_AUDIO_LOCALLY=true

# Audit log (append-only JSONL; no image data ever)
AUDIT_LOG=../data/audit/film-events.jsonl

# Notices. For every film-event of an opted-out badge the camera key files `record_capture` (when they were
# filmed) and, once they have been told, `record_notice` (when + how) on-chain. The person behind a badge id
# comes from the `contact` entries in the seed file — never on-chain.
NOTIFY_ON_CHAIN=true

# Email notices. `dry-run` (default) composes the message, appends it to NOTICE_LOG and sends nothing —
# and therefore does NOT set the CHANNEL_EMAIL bit in the on-chain notice, because nobody was told.
# `send` posts it through Resend and sets the bit only on a confirmed 2xx.
#   1. https://resend.com → API Keys → create one (free tier: 100/day, no card)
#   2. RESEND_API_KEY=re_xxxxx  and  EMAIL_MODE=send
# EMAIL_FROM must be a Resend-verified sender. `onboarding@resend.dev` works with no domain setup, but
# only delivers to the address that owns the Resend account — verify a domain to mail anyone else.
EMAIL_MODE=dry-run
RESEND_API_KEY=
EMAIL_FROM=Consentinel <onboarding@resend.dev>
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=8000
# Demo delivery redirect. `onboarding@resend.dev` only delivers to the address that owns the Resend
# account, so set this to that address and every notice lands there — while each contact keeps their
# own address on the operator screen and in NOTICE_LOG (`to`), with the redirect recorded as
# `redirectedTo`. Shown in /health and the startup banner, not on the operator panel.
# With this set, CHANNEL_EMAIL means "a mail was sent about this person", not "they received it".
# Leave EMPTY for anything real.
EMAIL_REDIRECT_TO=
CONTACTS_FILE=../data/demo/seed-consents.json
NOTICE_LOG=../data/audit/notices.jsonl
# A badge that stays in frame fires a film-event every few seconds (the alarm needs that); the person gets ONE
# on-chain notice per this window, later events in it are covered by it (still audited and attested).
NOTICE_MIN_INTERVAL_MS=60000

# Badge radio (see BADGE_PROTOCOL.md). A CNSR request from the badge's A button is signed with the
# badge's own key from this directory (badge-<ID>.json, written by `npm run seed`) and relayed on-chain.
BADGE_KEYS_DIR=../registry/keys
# While a radio bridge is connected, re-mirror every badge's consent this often (ms; 0 = off).
# The program-log subscription pushes changes immediately; this is the backstop.
RADIO_SYNC_MS=20000

# Auto-enrol: a badge id the camera sees for the first time is registered as opt_out by the organizer
# (issuer) key, so its card appears and can be granted. opt_out can never un-blur anyone.
AUTO_REGISTER=true
ISSUER_KEYPAIR=~/.config/solana/id.json
DEMO_KEYS_FILE=../capture-app/public/demo/badges.json
AUTO_REGISTER_MAX=50
